# Keys for dictation. The installer copies this to ~/.config/dictate/env
# (readable only by you). Fill in what you use, then run:
#   systemctl --user restart voxtype
# Never share or commit the filled-in file.

# Groq (https://console.groq.com/keys): fast, accurate Whisper in the cloud.
# Needed when the Voxtype config says mode = "remote".
VOXTYPE_WHISPER_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys): the cleanup pass.
# Leave empty and dictation types Whisper's text as it is.
ANTHROPIC_API_KEY=

# Optional:
# DICTATE_MODEL=claude-haiku-4-5   # the model the cleanup uses
# DICTATE_NO_CLEANUP=1             # skip the cleanup even with a key
